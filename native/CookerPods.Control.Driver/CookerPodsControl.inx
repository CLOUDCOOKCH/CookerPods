; CookerPods original AAP profile driver. Development build, not a signed package.
[Version]
Signature="$WINDOWS NT$"
Class=Bluetooth
ClassGuid={e0cbf06c-cd8b-4647-bb8a-263b43f0f974}
Provider=%Provider%
DriverVer=10/15/2026,0.6.0.0
CatalogFile=CookerPodsControl.cat
PnpLockdown=1

[DestinationDirs]
DefaultDestDir=13

[SourceDisksNames]
1=%Disk%,,,""

[SourceDisksFiles]
CookerPodsControl.sys=1

[Manufacturer]
%Provider%=CookerPods,NT$ARCH$.10.0.1..19041

[CookerPods.NT$ARCH$.10.0.1..19041]
%Device%=Install,BTHENUM\{74ec2172-0bad-4d01-8f77-997b2be0722a}

[Install.NT]
CopyFiles=DriverFiles

[DriverFiles]
CookerPodsControl.sys

[Install.NT.Services]
AddService=CookerPodsControl,0x00000002,Service

[Service]
DisplayName=%Device%
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%13%\CookerPodsControl.sys

[Install.NT.Wdf]
KmdfService=CookerPodsControl,Wdf

[Wdf]
KmdfLibraryVersion=$KMDFVERSION$

[Strings]
Provider="CookerPods"
Device="CookerPods AirPods Control (development)"
Disk="CookerPods Control development driver"
